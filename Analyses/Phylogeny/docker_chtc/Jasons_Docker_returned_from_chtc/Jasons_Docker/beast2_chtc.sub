# HTC Submit File

# Provide HTCondor with the name of the Docker container
container_image = docker://jzraiti/beast2_chtc:1.12
universe = container

# Specify executable to be run on start
executable = beast.sh

# transfer the files we need for the program
transfer_input_files = beast.xml

# outputs
log = job.log
error = job.err
output = job.out

# request resources 
request_cpus = 4
request_memory = 24GB
request_disk = 12GB

queue
